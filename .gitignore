# ============================================================
# SmartPump AI  - .gitignore
# ============================================================

# --- Dataset files (download separately, never commit) ------
data/raw/*
!data/raw/.gitkeep
!data/raw/README.md

data/processed/*
!data/processed/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/

# --- Virtual environments ---
venv/
env/
ENV/
.venv/

# --- Jupyter Notebooks ---
# Commit notebooks with cleared outputs only
.ipynb_checkpoints/

# --- Trained models (can be large; regenerate from code) ---
models/*.pkl
models/*.joblib
models/*.model
!models/.gitkeep

# --- Results (regenerate from code; keep plots in results/ if small) ---
results/*.csv
results/*.json
!results/.gitkeep

# --- IDE and OS ---
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Testing and scratch ---
.pytest_cache/
scratch/
.dist/

# --- Logs ---
*.log
logs/

